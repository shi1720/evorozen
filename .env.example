# Copy to .env for local development. Never commit real credentials.
PORT=3000
HOST=0.0.0.0
# Canonical external origin; production should use HTTPS and no trailing slash.
# APP_ORIGIN=https://your-remainder.example
# Set only behind a trusted reverse proxy with one hop.
TRUST_PROXY=0

# Local development persists under .data/remainder without a database account.
# DATA_DIR=.data/remainder
# Production requires durable PostgreSQL. Follow your provider's TLS instructions.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_POOL_SIZE=5
# Alternative: one process and a persistent volume; explicitly opt in.
# ALLOW_LOCAL_DATABASE=1
# DATA_DIR=/data/remainder

# Provider selection: Evorozen, then OpenAI, then Gemini, according to configured keys.
# With only GEMINI_API_KEY configured, Gemini is the primary live provider.
# Keys are server-side only. Never create VITE_* secret variables.
EVOROZEN_API_KEY=
# Neural Pulse has a 2000-character prompt cap; extraction uses bounded windows.
EVOROZEN_MAX_CALLS_PER_ANALYSIS=8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_ENABLED=false
AI_TIMEOUT_MS=45000

# Shared durable daily budgets count outbound AI attempts, including fallbacks.
# Failed outbound attempts count. Cached results and demo replay do not.
# UTC midnight reset; 0 disables new real AI calls. Provider limits still apply.
AI_MAX_DAILY_CALLS=30
AI_MAX_DAILY_CALLS_PER_USER=10
